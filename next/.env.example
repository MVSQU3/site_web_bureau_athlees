# Copie ce fichier en ".env.local" (dans le dossier next/) puis remplis les valeurs.

# Adresse de la base PostgreSQL (Neon) : Vercel → Storage → ta base → ".env.local" → DATABASE_URL
DATABASE_URL=postgres://utilisateur:motdepasse@hote.neon.tech/neondb?sslmode=require

# Une longue chaîne aléatoire (32 caractères ou plus) pour signer les sessions
AUTH_SECRET=remplace-moi-par-une-longue-chaine-aleatoire

# Premier compte administrateur, créé automatiquement si aucun compte n'existe encore
ADMIN_EMAIL=toi@exemple.ci
ADMIN_PASSWORD=un-mot-de-passe-de-8-caracteres-minimum
